# .gitignore for a git repo rooted at temporal_networks/
#
# Goal: the repo carries exactly what is needed to run
# ``seir_sweep/run_sweep.py`` on another machine, and nothing else.
#
# The tracked set is 15 files / ~536 KB (14 below, plus this .gitignore):
#
#   gillespie_seir.py  gmm_contacts.py  network.py  outbreak_metrics.py
#   seir_comparison_common.py  temporal.py
#   seir_sweep/{run_sweep,config,builders,metrics,calibrate_beta}.py
#   seir_sweep/README.md  seir_sweep/run_sweep.slurm
#   seir_sweep/outputs/fits_cache.pkl
#
# Verified by cloning exactly that set into an isolated directory with the
# survey data unreachable and running the sweep there: 50 runs, 0 errors.
#
# IMPORTANT -- why fits_cache.pkl is tracked despite being a binary artefact:
# the raw survey data lives OUTSIDE this folder (../analyse households and
# ../analytics/ego_data, ~740 MB), so a repo rooted here can never contain it.
# builders.get_fits() reads fits_cache.pkl and never touches the raw data when
# it exists, so shipping that one 328 KB file is what makes the repo runnable
# standalone. It holds pickled sklearn GaussianMixture objects, so it is
# sklearn-version-sensitive: if the target machine errors on unpickling, either
# match the scikit-learn version or regenerate the fit where the survey data
# is available (see seir_sweep/README.md).

# ---------------------------------------------------------------------------
# Ignore everything by default, then re-allow only what is needed.
# This keeps new scratch files, notebooks and outputs out automatically.
# ---------------------------------------------------------------------------
*
!*/

# --- Python modules imported by run_sweep.py (the full import chain) --------
!gillespie_seir.py
!gmm_contacts.py
!network.py
!outbreak_metrics.py
!seir_comparison_common.py
!temporal.py

# --- the sweep package -----------------------------------------------------
!seir_sweep/run_sweep.py
!seir_sweep/config.py
!seir_sweep/builders.py
!seir_sweep/metrics.py
!seir_sweep/calibrate_beta.py
!seir_sweep/README.md
!seir_sweep/run_sweep.slurm

# --- fitted parameters: makes the repo self-contained (see note above) ------
!seir_sweep/outputs/fits_cache.pkl

# --- this file -------------------------------------------------------------
!.gitignore

# ---------------------------------------------------------------------------
# Belt-and-braces: re-assert the big / regenerable things, so they stay
# ignored even if someone loosens the catch-all above.
# ---------------------------------------------------------------------------

# sweep results (regenerated by running the sweep; can reach many GB)
seir_sweep/outputs/shards/
seir_sweep/outputs/_done/
seir_sweep/outputs/transmission_logs/
seir_sweep/outputs/daily_series/
seir_sweep/outputs/runs_summary.csv
seir_sweep/outputs/network_summary.csv
seir_sweep/outputs/manifest.json
seir_sweep/outputs/beta_r0_calibration.csv

# slurm job logs (written next to the script by run_sweep.slurm)
seir_sweep/slurm_logs/

# earlier pipelines' outputs, figures and logs.
# NOTE the leading slash: it anchors these to the repo root. Without it,
# "outputs/" would also match seir_sweep/outputs/, and because git never
# descends into an excluded directory, that would silently drop the tracked
# seir_sweep/outputs/fits_cache.pkl no matter what negation follows.
/outputs/
/outputs_loggmm/
/outputs_egoresample/
/figs/
/run_logs/

# notebooks and the analysis-only modules they use
*.ipynb
.ipynb_checkpoints/

# python noise
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
